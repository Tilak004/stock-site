---
import Base from "../../layouts/Base.astro";

const title = "SIP Calculator — Monthly Investment Returns";
const description =
  "Calculate what a monthly SIP could grow to at an assumed rate of return. " +
  "Shows total invested, estimated value and the gain, with the formula used.";
---

<Base title={title} description={description} crumb="Tools / SIP calculator">
  <h1>SIP calculator</h1>
  <p class="lede">
    Works out what a fixed monthly investment would grow to at an assumed
    constant rate of return. The rate is an assumption you supply — not a
    forecast, and not a rate this site is suggesting.
  </p>

  <div class="calc">
    <div class="calc-in">
      <div class="fld">
        <label for="amt">Monthly investment (₹)</label>
        <input type="number" id="amt" value="10000" min="0" step="500" />
      </div>
      <div class="fld">
        <label for="yrs">Period (years)</label>
        <input type="number" id="yrs" value="10" min="0.5" max="60" step="0.5" />
      </div>
      <div class="fld">
        <label for="rate">Assumed return (% per year)</label>
        <input type="number" id="rate" value="12" min="0" max="50" step="0.5" />
        <div class="hint">An assumption. Equity returns vary widely and can be negative.</div>
      </div>
      <div class="fld">
        <label for="when">Instalment timing</label>
        <select id="when">
          <option value="begin">Start of month</option>
          <option value="end">End of month</option>
        </select>
      </div>
    </div>
    <div class="calc-out">
      <div class="out-hero" id="fv">—</div>
      <div class="lede" style="font-size:.78rem;margin:.2rem 0 .8rem">estimated value at the end</div>
      <div class="out-row"><span class="lbl">Total invested</span><span class="val" id="inv">—</span></div>
      <div class="out-row"><span class="lbl">Estimated gain</span><span class="val" id="gain">—</span></div>
      <div class="out-row"><span class="lbl">Instalments</span><span class="val" id="n">—</span></div>
      <div class="err" id="err"></div>
    </div>
  </div>

  <h2>How it is calculated</h2>
  <p>
    Each instalment compounds for however many months remain. Summing that
    geometric series gives the standard future-value-of-an-annuity formula:
  </p>
  <div class="formula">FV = P × [ (1 + i)^n − 1 ] / i   × (1 + i if paid at start of month)</div>
  <p class="lede">
    <span class="c">P</span> is the monthly amount, <span class="c">n</span> the
    number of instalments, and <span class="c">i</span> the monthly rate, taken
    as the annual rate divided by 12.
  </p>

  <h2>What this does not account for</h2>
  <div class="defs">
    <div class="def">
      <div class="h"><code>constant_return</code><span class="meta">assumption</span></div>
      <p>Real returns vary year to year and can be negative for long stretches.
        A steady 12% is a convenience, not a description of any real fund.</p>
    </div>
    <div class="def">
      <div class="h"><code>no_costs</code><span class="meta">excluded</span></div>
      <p>Expense ratio, exit load, stamp duty and taxes are not deducted. Actual
        outcomes will be lower.</p>
    </div>
    <div class="def">
      <div class="h"><code>no_inflation</code><span class="meta">excluded</span></div>
      <p>The result is a nominal figure. Use the
        <a href="/tools/inflation-calculator/">inflation calculator</a> to see
        what it is worth in today's money.</p>
    </div>
  </div>

  <div class="ad">Advertisement</div>

  <p class="lede">
    Related: <a href="/tools/step-up-sip-calculator/">step-up SIP</a> ·
    <a href="/tools/cagr-calculator/">CAGR</a> ·
    <a href="/tools/xirr-calculator/">XIRR</a>
  </p>

  <script is:inline>
    const $ = (i) => document.getElementById(i);
    const inr = (v) =>
      "₹" + Math.round(v).toLocaleString("en-IN", { maximumFractionDigits: 0 });

    function run() {
      const P = +$("amt").value, Y = +$("yrs").value, R = +$("rate").value;
      const begin = $("when").value === "begin";
      $("err").textContent = "";

      if (!(P >= 0) || !(Y > 0) || !(R >= 0)) {
        $("fv").textContent = "—"; $("inv").textContent = "—";
        $("gain").textContent = "—"; $("n").textContent = "—";
        $("err").textContent = "Enter a positive amount, period and rate.";
        return;
      }

      const n = Math.round(Y * 12);
      const i = R / 100 / 12;
      // i === 0 is a real input, and the annuity formula divides by i — handle it
      // as a plain sum rather than returning NaN.
      let fv = i === 0 ? P * n : P * ((Math.pow(1 + i, n) - 1) / i);
      if (begin && i !== 0) fv *= 1 + i;

      const invested = P * n;
      $("fv").textContent = inr(fv);
      $("inv").textContent = inr(invested);
      $("gain").textContent = inr(fv - invested);
      $("n").textContent = n;
    }

    ["amt", "yrs", "rate", "when"].forEach((id) =>
      $(id).addEventListener("input", run));
    run();
  </script>
</Base>
