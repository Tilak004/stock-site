---
import Base from "../../layouts/Base.astro";

const title = "CAGR Calculator — Compound Annual Growth Rate";
const description =
  "Calculate the compound annual growth rate between a starting and ending " +
  "value over any period, with the formula and its limitations explained.";
---

<Base title={title} description={description} crumb="Tools / CAGR calculator">
  <h1>CAGR calculator</h1>
  <p class="lede">
    CAGR is the single constant annual rate that would take a starting value to
    an ending value over a given period. It smooths away everything that
    happened in between.
  </p>

  <div class="calc">
    <div class="calc-in">
      <div class="fld">
        <label for="beg">Initial value (₹)</label>
        <input type="number" id="beg" value="100000" min="0.01" step="1000" />
      </div>
      <div class="fld">
        <label for="end">Final value (₹)</label>
        <input type="number" id="end" value="250000" min="0" step="1000" />
      </div>
      <div class="fld">
        <label for="yrs">Period (years)</label>
        <input type="number" id="yrs" value="7" min="0.1" max="100" step="0.5" />
      </div>
    </div>
    <div class="calc-out">
      <div class="out-hero" id="cagr">—</div>
      <div class="lede" style="font-size:.78rem;margin:.2rem 0 .8rem">compound annual growth rate</div>
      <div class="out-row"><span class="lbl">Absolute return</span><span class="val" id="abs">—</span></div>
      <div class="out-row"><span class="lbl">Times multiplied</span><span class="val" id="mult">—</span></div>
      <div class="out-row"><span class="lbl">Gain</span><span class="val" id="gain">—</span></div>
      <div class="err" id="err"></div>
    </div>
  </div>

  <h2>How it is calculated</h2>
  <div class="formula">CAGR = ( End / Begin )^(1 / years) − 1</div>
  <p class="lede">
    Note this depends only on the first and last values. An investment that fell
    60% and then recovered has exactly the same CAGR as one that rose steadily to
    the same endpoint — the experience of holding them was not remotely the same.
  </p>

  <h2>When CAGR is the wrong tool</h2>
  <div class="defs">
    <div class="def">
      <div class="h"><code>cash_flows</code><span class="meta">use XIRR instead</span></div>
      <p>CAGR assumes one lump sum in and one value out. If you added or withdrew
        money along the way — an SIP, for instance — use
        <a href="/tools/xirr-calculator/">XIRR</a>.</p>
    </div>
    <div class="def">
      <div class="h"><code>hides_volatility</code><span class="meta">limitation</span></div>
      <p>Two investments with identical CAGR can have wildly different drawdowns.
        CAGR says nothing about the path.</p>
    </div>
    <div class="def">
      <div class="h"><code>short_periods</code><span class="meta">caution</span></div>
      <p>Annualising a few months of returns extrapolates a short run into a
        yearly rate and usually overstates it.</p>
    </div>
  </div>

  <div class="ad">Advertisement</div>

  <p class="lede">
    Related: <a href="/tools/xirr-calculator/">XIRR</a> ·
    <a href="/tools/sip-calculator/">SIP</a> ·
    <a href="/tools/inflation-calculator/">inflation</a>
  </p>

  <script is:inline>
    const $ = (i) => document.getElementById(i);
    const inr = (v) => "₹" + Math.round(v).toLocaleString("en-IN");

    function run() {
      const b = +$("beg").value, e = +$("end").value, y = +$("yrs").value;
      $("err").textContent = "";
      const bad = !(b > 0) || !(e >= 0) || !(y > 0);
      if (bad) {
        ["cagr", "abs", "mult", "gain"].forEach((id) => ($(id).textContent = "—"));
        $("err").textContent = "Initial value and period must be greater than zero.";
        return;
      }
      const cagr = (Math.pow(e / b, 1 / y) - 1) * 100;
      const abs = (e / b - 1) * 100;
      $("cagr").textContent = cagr.toFixed(2) + "%";
      $("cagr").className = "out-hero " + (cagr >= 0 ? "pos" : "neg");
      $("abs").textContent = abs.toFixed(2) + "%";
      $("mult").textContent = (e / b).toFixed(2) + "×";
      $("gain").textContent = inr(e - b);
    }
    ["beg", "end", "yrs"].forEach((id) => $(id).addEventListener("input", run));
    run();
  </script>
</Base>
