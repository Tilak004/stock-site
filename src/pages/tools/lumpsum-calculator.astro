---
import Base from "../../layouts/Base.astro";

const title = "Lumpsum Calculator — One-Time Investment Growth";
const description =
  "Calculate what a one-time investment grows to at an assumed rate, and see how " +
  "the same amount would compare if invested monthly instead.";
---

<Base title={title} description={description} crumb="Tools / Lumpsum calculator">
  <h1>Lumpsum calculator</h1>
  <p class="lede">
    What a single one-time investment becomes at an assumed constant rate. The
    rate is your assumption — not a forecast, and not a rate this site suggests.
  </p>

  <div class="calc">
    <div class="calc-in">
      <div class="fld">
        <label for="p">Amount invested (₹)</label>
        <input type="number" id="p" value="500000" min="0" step="10000" />
      </div>
      <div class="fld">
        <label for="y">Period (years)</label>
        <input type="number" id="y" value="10" min="0.5" max="60" step="0.5" />
      </div>
      <div class="fld">
        <label for="r">Assumed return (% per year)</label>
        <input type="number" id="r" value="12" min="0" max="50" step="0.5" />
      </div>
      <div class="fld">
        <label for="c">Compounding</label>
        <select id="c">
          <option value="1">Annual</option>
          <option value="4">Quarterly</option>
          <option value="12">Monthly</option>
        </select>
      </div>
    </div>
    <div class="calc-out">
      <div class="out-hero" id="fv">—</div>
      <div class="lede" style="font-size:.78rem;margin:.2rem 0 .8rem">estimated value at the end</div>
      <div class="out-row"><span class="lbl">Gain</span><span class="val" id="g">—</span></div>
      <div class="out-row"><span class="lbl">Times multiplied</span><span class="val" id="m">—</span></div>
      <div class="out-row"><span class="lbl">Same total, invested monthly instead</span><span class="val" id="sip">—</span></div>
      <div class="err" id="err"></div>
    </div>
  </div>

  <h2>How it is calculated</h2>
  <div class="formula">FV = P × (1 + r/m)^(m × years)

m = compounding periods per year</div>

  <h2>Lumpsum or SIP?</h2>
  <p class="lede">
    The last row splits the same total into equal monthly instalments across the
    period, so the two are directly comparable. Lumpsum usually ends higher
    simply because the money is invested for longer — but it also means
    committing everything at a single price. Which suits you depends on whether
    you actually have the sum today, and on how you would react if it fell 20%
    next month.
  </p>

  <div class="defs">
    <div class="def">
      <div class="h"><code>no_costs_or_tax</code><span class="meta">excluded</span></div>
      <p>Expense ratio, exit load and capital gains tax are not deducted. Real
        outcomes are lower.</p>
    </div>
    <div class="def">
      <div class="h"><code>constant_return</code><span class="meta">assumption</span></div>
      <p>No real investment delivers a steady rate. This is arithmetic, not a
        projection.</p>
    </div>
  </div>

  <div class="ad">Advertisement</div>

  <p class="lede">
    Related: <a href="/tools/sip-calculator/">SIP</a> ·
    <a href="/tools/cagr-calculator/">CAGR</a> ·
    <a href="/tools/inflation-calculator/">inflation</a>
  </p>

  <script is:inline>
    const $ = (i) => document.getElementById(i);
    const inr = (v) => "₹" + Math.round(v).toLocaleString("en-IN");

    function run() {
      const P = +$("p").value, Y = +$("y").value, R = +$("r").value, m = +$("c").value;
      $("err").textContent = "";
      if (!(P >= 0) || !(Y > 0) || !(R >= 0)) {
        ["fv", "g", "m", "sip"].forEach((i) => ($(i).textContent = "—"));
        $("err").textContent = "Enter a non-negative amount and a period above zero.";
        return;
      }
      const fv = P * Math.pow(1 + R / 100 / m, m * Y);
      $("fv").textContent = inr(fv);
      $("g").textContent = inr(fv - P);
      $("m").textContent = (P > 0 ? (fv / P).toFixed(2) : "0") + "×";

      // Same total, spread evenly month by month, for a like-for-like comparison.
      const n = Math.round(Y * 12), i = R / 100 / 12, per = P / n;
      const sipFv = i === 0 ? per * n : per * ((Math.pow(1 + i, n) - 1) / i) * (1 + i);
      $("sip").textContent = inr(sipFv);
    }
    ["p", "y", "r", "c"].forEach((i) => $(i).addEventListener("input", run));
    run();
  </script>
</Base>
