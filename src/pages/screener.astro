---
import Base from "../layouts/Base.astro";

const title = "Technical Screener — Filter NSE Stocks by Indicator Values";
const description =
  "Filter NSE stocks by RSI, ADX, moving averages, relative volume and distance " +
  "from the 52-week high. Set your own thresholds and see how many stocks qualify.";
---

<Base title={title} description={description} crumb="Screener / All stocks">
  <h1>Technical screener</h1>
  <p class="lede">
    Standard indicators computed from daily NSE price data. Set the thresholds in
    the panel — <span class="c">rsi</span>, <span class="c">adx</span>,
    <span class="c">vol_ratio</span> and the rest are evaluated against your
    values, not ours.
  </p>

  <div class="note" id="freshness">Loading data…</div>

  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th data-k="ticker">Stock</th>
          <th data-k="close">Close</th>
          <th data-k="chg_pct">Chg%</th>
          <th data-k="rsi">RSI</th>
          <th data-k="adx">ADX</th>
          <th data-k="vol_ratio">Vol×</th>
          <th data-k="pct_from_52wh">52wH</th>
          <th data-k="turnover_cr">₹cr</th>
          <th data-k="met">Met</th>
        </tr>
      </thead>
      <tbody id="tb"></tbody>
    </table>
  </div>
  <div class="pager">
    <button class="pgbtn" id="prev" type="button" aria-label="Previous page">&larr; Prev</button>
    <span class="pos" id="pos">&mdash;</span>
    <button class="pgbtn" id="next" type="button" aria-label="Next page">Next &rarr;</button>
    <span class="spacer"></span>
    <label for="per">Rows</label>
    <select id="per" style="width:auto">
      <option value="10" selected>10</option>
      <option value="25">25</option>
      <option value="50">50</option>
      <option value="100">100</option>
    </select>
  </div>

  <div class="ad">Advertisement</div>

  <h2>Conditions</h2>
  <p class="lede">
    Six conditions are evaluated per stock. Every one is a standard formula you
    can verify anywhere — nothing here is proprietary.
  </p>

  <div class="defs">
    <div class="def">
      <div class="h"><code>above_200dma</code><span class="meta">boolean · close &gt; EMA200</span></div>
      <p>A widely used long-term trend reference.</p>
    </div>
    <div class="def">
      <div class="h"><code>ema21_above_50</code><span class="meta">boolean</span></div>
      <p>The shorter average above the longer one.</p>
    </div>
    <div class="def">
      <div class="h"><code>rsi_in_band</code><span class="meta">boolean · threshold</span></div>
      <p>Excludes both the oversold and the overbought extreme.</p>
    </div>
    <div class="def">
      <div class="h"><code>adx_trending</code><span class="meta">boolean · threshold</span></div>
      <p>Trend strength regardless of direction. A low reading means sideways, not falling.</p>
    </div>
    <div class="def">
      <div class="h"><code>volume_above_avg</code><span class="meta">boolean · threshold</span></div>
      <p>Session volume against its own 20-day average.</p>
    </div>
    <div class="def">
      <div class="h"><code>near_52w_high</code><span class="meta">boolean · threshold</span></div>
      <p>Where the current price sits within its yearly range.</p>
    </div>
  </div>

  <!-- ── Right rail ─────────────────────────────────────────────────────── -->
  <Fragment slot="rail">
    <div class="pane">
      <div class="pane-h">
        <span>FILTERS</span>
        <button class="tbtn" id="reset" type="button" style="font-family:var(--mono)">reset</button>
      </div>
      <div class="pane-b">
        <div class="ctl">
          <label for="a">rsi minimum <b id="av">35</b></label>
          <input type="range" id="a" min="0" max="100" value="35" />
        </div>
        <div class="ctl">
          <label for="b">rsi maximum <b id="bv">70</b></label>
          <input type="range" id="b" min="0" max="100" value="70" />
        </div>
        <div class="ctl">
          <label for="c">adx minimum <b id="cv">18</b></label>
          <input type="range" id="c" min="0" max="60" value="18" />
        </div>
        <div class="ctl">
          <label for="d">vol_ratio minimum <b id="dv">1.0</b></label>
          <input type="range" id="d" min="0" max="30" value="10" />
        </div>
        <div class="ctl">
          <label for="e">within % of 52w high <b id="ev">25</b></label>
          <input type="range" id="e" min="0" max="90" value="25" />
        </div>
        <div class="ctl">
          <label for="f">conditions met</label>
          <select id="f">
            <option value="0">any</option>
            <option value="3">3 or more</option>
            <option value="4">4 or more</option>
            <option value="5">5 or more</option>
            <option value="6">all 6</option>
          </select>
        </div>
        <div class="ctl">
          <label for="g">sector</label>
          <select id="g"><option value="">all sectors</option></select>
        </div>
      </div>
      <div class="readout">
<span class="k">&#123;</span>
  <span class="k">"matched"</span>: <span class="v" id="cnt">—</span>,
  <span class="k">"of"</span>: <span class="s" id="tot">—</span>,
  <span class="k">"scanned"</span>: <span class="s" id="scan">—</span>,
  <span class="k">"bar"</span>: <span class="s" id="bar">—</span>
<span class="k">&#125;</span>
      </div>
    </div>

    <p style="color:var(--faint);font-size:.76rem;margin-top:.9rem">
      Conditions are recomputed from raw values on every change — move a slider
      and watch how fast the match count collapses. That relationship is the
      reason a screen that looks selective can still be meaningless.
    </p>
  </Fragment>

  <script is:inline>
    // Astro renders the default slot (.doc, where this script sits) BEFORE the
    // named "rail" slot, so the filter controls do not exist yet at parse time.
    // Without this wrapper getElementById returns null, binding the listeners
    // throws, and the whole script dies silently — dead filters, empty table.
    document.addEventListener("DOMContentLoaded", function () {
    const $ = (i) => document.getElementById(i);
    const f = (v, d = 2) =>
      v === null || v === undefined ? '<span class="na">—</span>' : Number(v).toFixed(d);

    let DATA = [], sk = "turnover_cr", sd = -1, page = 1;

    const T = () => ({
      lo: +$("a").value, hi: +$("b").value, adx: +$("c").value,
      vol: +$("d").value / 10, p52: -Math.abs(+$("e").value),
      min: +$("f").value, sec: $("g").value,
    });

    // Recomputed from raw values on every input — that is the teaching mechanic,
    // and it is why the snapshot ships values rather than precomputed flags.
    const ev = (r, t) =>
      [
        r.close !== null && r.ema200 !== null ? r.close > r.ema200 : null,
        r.ema21 !== null && r.ema50 !== null ? r.ema21 > r.ema50 : null,
        r.rsi !== null ? r.rsi >= t.lo && r.rsi <= t.hi : null,
        r.adx !== null ? r.adx >= t.adx : null,
        r.vol_ratio !== null ? r.vol_ratio >= t.vol : null,
        r.pct_from_52wh !== null ? r.pct_from_52wh >= t.p52 : null,
      ].filter((x) => x === true).length;

    function draw() {
      const t = T();
      $("av").textContent = t.lo; $("bv").textContent = t.hi;
      $("cv").textContent = t.adx; $("dv").textContent = t.vol.toFixed(1);
      $("ev").textContent = Math.abs(t.p52);

      let rows = DATA.map((r) => ({ ...r, _m: ev(r, t) }))
        .filter((r) => r._m >= t.min && (!t.sec || r.sector === t.sec));

      rows.sort((x, y) => {
        const a = sk === "met" ? x._m : x[sk], b = sk === "met" ? y._m : y[sk];
        if (a === null || a === undefined) return 1;
        if (b === null || b === undefined) return -1;
        return typeof a === "string" ? a.localeCompare(b) * sd : (a - b) * sd;
      });

      $("cnt").textContent = rows.length;

      const per = +$("per").value;
      const pages = Math.max(1, Math.ceil(rows.length / per));
      // A filter change can shrink the result set below the current page.
      if (page > pages) page = pages;
      const start = (page - 1) * per;
      const shown = rows.slice(start, start + per);

      $("pos").textContent = rows.length
        ? `${start + 1}–${start + shown.length} of ${rows.length}`
        : "no matches";
      $("prev").disabled = page <= 1;
      $("next").disabled = page >= pages;

      $("tb").innerHTML = shown.map((r) => {
        const c = r.chg_pct === null ? "" : r.chg_pct >= 0 ? "up" : "down";
        return `<tr>
          <td><div class="tk">${r.ticker}</div><div class="sec">${r.sector ?? ""}</div></td>
          <td class="n">${f(r.close)}</td><td class="n ${c}">${f(r.chg_pct)}</td>
          <td class="n">${f(r.rsi, 1)}</td><td class="n">${f(r.adx, 1)}</td>
          <td class="n">${f(r.vol_ratio)}</td><td class="n">${f(r.pct_from_52wh, 1)}</td>
          <td class="n">${f(r.turnover_cr, 0)}</td>
          <td class="met"><b>${r._m}</b>/6</td></tr>`;
      }).join("");

    }

    fetch("/data/snapshot.json")
      .then((r) => { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
      .then((d) => {
        DATA = d.stocks || [];
        const dates = DATA.map((r) => r.bar_date).filter(Boolean).sort();
        const newest = dates[dates.length - 1] || "unknown";
        const stale = DATA.filter((r) => r.bar_date !== newest).length;

        $("tot").textContent = DATA.length;
        $("scan").textContent = d.universe_scanned ?? "—";
        $("bar").textContent = '"' + newest + '"';

        const secs = [...new Set(DATA.map((r) => r.sector).filter(Boolean))].sort();
        $("g").insertAdjacentHTML("beforeend",
          secs.map((s) => `<option value="${s}">${s}</option>`).join(""));

        $("freshness").innerHTML = stale
          ? `<b>Data freshness.</b> ${stale} of ${DATA.length} rows carry a last bar older than ${newest}. Rows that are behind are flagged rather than presented as current.`
          : `<b>Data freshness.</b> All ${DATA.length} rows computed from the ${newest} session · published ${new Date(d.generated_at).toLocaleString("en-IN")}.`;

        draw();
      })
      .catch((e) => {
        $("freshness").innerHTML =
          `<b>Data unavailable.</b> The snapshot could not be loaded (${e.message}). No values are shown rather than estimated ones.`;
        $("cnt").textContent = "—";
      });

    // Changing a filter returns to page 1 — staying on page 7 of a set that just
    // shrank to 2 pages reads as a broken table.
    ["a", "b", "c", "d", "e", "f", "g"].forEach((i) =>
      $(i).addEventListener("input", () => { page = 1; draw(); }));

    $("per").addEventListener("change", () => { page = 1; draw(); });
    $("prev").addEventListener("click", () => { if (page > 1) { page--; draw(); } });
    $("next").addEventListener("click", () => { page++; draw(); });

    document.querySelectorAll("thead th").forEach((th) =>
      th.addEventListener("click", () => {
        const k = th.dataset.k;
        sd = sk === k ? -sd : -1; sk = k; page = 1; draw();
      }));

    $("reset").addEventListener("click", () => {
      $("a").value = 35; $("b").value = 70; $("c").value = 18;
      $("d").value = 10; $("e").value = 25; $("f").value = 0; $("g").value = "";
      page = 1; draw();
    });
    });
  </script>
</Base>
