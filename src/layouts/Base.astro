---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  /** Breadcrumb shown above the H1, e.g. "Screener / All stocks". */
  crumb?: string;
  /** Set false on pages that should not be indexed. */
  index?: boolean;
}

const { title, description, crumb, index = true } = Astro.props;

const SITE_NAME = "Rulebook";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = Astro.url.pathname === "/" ? title : `${title} — ${SITE_NAME}`;
const path = Astro.url.pathname;

// Every group ships collapsed; `open` stays as a per-group override if one ever
// needs to be expanded by default. The group containing the current page is
// still auto-expanded below, so landing on a page never hides where you are.
// tag: LIVE = computed data, DOC = article, CALC = calculator. Same job as the
// POST/GET badges in an API reference — it tells you what a page is before you
// click it.
const groups = [
  {
    label: "Screener",
    open: false,
    items: [
      { href: "/screener/", label: "All stocks", tag: "LIVE", cls: "data" },
    ],
  },
  {
    label: "Technical analysis",
    open: false,
    items: [
      { href: "/learn/moving-averages/", label: "Moving averages", tag: "DOC", cls: "doc" },
      { href: "/learn/rsi/", label: "RSI", tag: "DOC", cls: "doc" },
      { href: "/learn/adx/", label: "ADX", tag: "DOC", cls: "doc" },
      { href: "/learn/volume/", label: "Volume & relative volume", tag: "DOC", cls: "doc" },
      { href: "/learn/support-resistance/", label: "Support and resistance", tag: "DOC", cls: "doc" },
    ],
  },
  {
    label: "Fundamentals",
    open: false,
    items: [
      { href: "/learn/reading-financials/", label: "Reading a financial statement", tag: "DOC", cls: "doc" },
      { href: "/learn/roe-roce/", label: "ROE and ROCE", tag: "DOC", cls: "doc" },
      { href: "/learn/debt-leverage/", label: "Debt and leverage", tag: "DOC", cls: "doc" },
      { href: "/learn/cash-flow/", label: "Cash flow vs profit", tag: "DOC", cls: "doc" },
      { href: "/learn/valuation-ratios/", label: "P/E, P/B and EV/EBITDA", tag: "DOC", cls: "doc" },
      { href: "/learn/evaluating-a-business/", label: "Evaluating a business", tag: "DOC", cls: "doc" },
      { href: "/learn/promoter-governance/", label: "Promoter holding & governance", tag: "DOC", cls: "doc" },
    ],
  },
  {
    label: "Trading",
    open: false,
    items: [
      { href: "/learn/swing-trading/", label: "Swing trading", tag: "DOC", cls: "doc" },
      { href: "/learn/backtesting/", label: "Backtesting", tag: "DOC", cls: "doc" },
      { href: "/learn/overfitting/", label: "Overfitting", tag: "DOC", cls: "doc" },
      { href: "/learn/risk-management/", label: "Risk management", tag: "DOC", cls: "doc" },
      { href: "/learn/trading-psychology/", label: "Trading psychology", tag: "DOC", cls: "doc" },
    ],
  },
  {
    label: "Investing",
    open: false,
    items: [
      { href: "/learn/cagr/", label: "CAGR and XIRR", tag: "DOC", cls: "doc" },
      { href: "/learn/compounding/", label: "Compounding", tag: "DOC", cls: "doc" },
      { href: "/learn/equity-vs-debt/", label: "Equity vs debt", tag: "DOC", cls: "doc" },
      { href: "/learn/asset-allocation/", label: "Asset allocation", tag: "DOC", cls: "doc" },
      { href: "/learn/inflation/", label: "Inflation", tag: "DOC", cls: "doc" },
    ],
  },
  {
    label: "Tools",
    open: false,
    items: [
      { href: "/tools/", label: "All calculators", tag: "CALC", cls: "calc" },
      { href: "/tools/sip-calculator/", label: "SIP", tag: "CALC", cls: "calc" },
      { href: "/tools/step-up-sip-calculator/", label: "Step-up SIP", tag: "CALC", cls: "calc" },
      { href: "/tools/cagr-calculator/", label: "CAGR", tag: "CALC", cls: "calc" },
      { href: "/tools/xirr-calculator/", label: "XIRR", tag: "CALC", cls: "calc" },
      { href: "/tools/inflation-calculator/", label: "Inflation", tag: "CALC", cls: "calc" },
      { href: "/tools/position-sizing/", label: "Position sizing", tag: "CALC", cls: "calc" },
      { href: "/tools/risk-reward/", label: "Risk / reward", tag: "CALC", cls: "calc" },
    ],
  },
  {
    label: "Reference",
    open: false,
    items: [
      { href: "/methodology/", label: "Methodology", tag: "DOC", cls: "doc" },
      { href: "/mutual-funds/", label: "Mutual funds", tag: "DOC", cls: "doc" },
      { href: "/about/", label: "About", tag: "DOC", cls: "doc" },
      { href: "/contact/", label: "Contact", tag: "DOC", cls: "doc" },
    ],
  },
];

const hasRail = Astro.slots.has("rail");
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!index && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Fonts are same-origin, so preloading removes a round trip on first paint. */}
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />

    {/* Applied before first paint so the theme never flashes. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark")
            document.documentElement.setAttribute("data-theme", t);
        } catch (e) { /* private mode — fall back to the OS preference */ }
      })();
    </script>
  </head>

  <body>
    <div class="shell">
      <aside class="aside" id="aside">
        <div class="aside-top">
          <a class="logo" href="/">Rulebook <em>/ NSE technicals</em></a>
          <label class="search">
            <span>Search</span>
            <input type="text" aria-label="Search the site" id="nav-search" />
            <span class="kbd">/</span>
          </label>
        </div>

        <div class="navscroll">
          {groups.map((g) => {
            const active = g.items.some((i) => path.startsWith(i.href));
            return (
              <>
                <button class="grp" type="button" aria-expanded={String(g.open || active)}>
                  <span>{g.label}</span><span class="ch">▶</span>
                </button>
                <ul class="sub" style={g.open || active ? "" : "display:none"}>
                  {g.items.map((i) => (
                    <li>
                      <a href={i.href} aria-current={path === i.href ? "page" : undefined}>
                        {i.label}<span class={`tag ${i.cls}`}>{i.tag}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            );
          })}
        </div>

        <div class="aside-bot">
          <span>Data: NSE daily</span>
          <button class="tbtn" id="theme-toggle" type="button"
                  aria-label="Switch between light and dark theme">Theme</button>
        </div>
      </aside>

      <main>
        <div class={hasRail ? "cols has-rail" : "cols"}>
          <div class="doc">
            {crumb && <div class="crumb">{crumb}</div>}
            <slot />

            <div class="foot">
              <b>Disclaimer.</b> Educational and informational purposes only. This
              site publishes values of standard technical indicators computed from
              publicly available market data, and lets you filter stocks using
              conditions you choose. It does not provide personalised investment
              advice, and nothing here is a recommendation to buy, sell or hold any
              security. Indicator values describe past price behaviour; they do not
              predict future prices. Historical or backtested results do not
              guarantee future performance. Please do your own research and consider
              your own circumstances, or consult a SEBI-registered investment adviser.
              <p style="margin-top:.8rem">
                <a href="/methodology/">Methodology</a> ·
                <a href="/about/">About</a> ·
                <a href="/privacy/">Privacy</a>
              </p>
            </div>
          </div>

          {hasRail && <div class="rail"><slot name="rail" /></div>}
        </div>
      </main>
    </div>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", function () {
        var el = document.documentElement;
        var cur = el.getAttribute("data-theme");
        if (!cur) cur = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        var next = cur === "dark" ? "light" : "dark";
        el.setAttribute("data-theme", next);
        try { localStorage.setItem("theme", next); } catch (e) { /* ignore */ }
      });

      document.querySelectorAll(".grp").forEach(function (g) {
        g.addEventListener("click", function () {
          var open = g.getAttribute("aria-expanded") === "true";
          g.setAttribute("aria-expanded", String(!open));
          var ul = g.nextElementSibling;
          if (ul && ul.classList.contains("sub")) ul.style.display = open ? "none" : "";
        });
      });

      // "/" focuses search, the way a docs site behaves.
      document.addEventListener("keydown", function (e) {
        if (e.key === "/" && document.activeElement?.tagName !== "INPUT") {
          e.preventDefault();
          document.getElementById("nav-search")?.focus();
        }
      });
    </script>
  </body>
</html>
