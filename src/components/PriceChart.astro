---
/**
 * PriceChart.astro — an annotated price chart of a real stock.
 *
 * Built at build time from series.json. Two stacked panels: price (with optional
 * moving averages) on top, one indicator underneath, and automatic callouts on
 * the extreme readings so a first-time reader can see what the indicator was
 * doing at a moment that is visibly interesting on the price line.
 *
 * This exists because a distribution chart only means something to someone who
 * already knows the indicator. A beginner needs to see the price, the indicator,
 * and a marker joining the two.
 */
import series from "../../public/data/series.json";

export interface Props {
  ticker: string;
  /** Which indicator to draw in the lower panel. */
  indicator: "rsi" | "adx" | "vol_ratio";
  /** Horizontal reference lines in the lower panel, e.g. [30, 70]. */
  levels?: number[];
  /** Shade above this value / below this value in the lower panel. */
  shadeAbove?: number;
  shadeBelow?: number;
  /** Draw moving averages on the price panel. */
  showMAs?: boolean;
  title: string;
  caption?: string;
  /** Annotate the highest and/or lowest indicator reading in the window. */
  markPeak?: boolean;
  markTrough?: boolean;
  peakNote?: string;
  troughNote?: string;
}

const {
  ticker, indicator, levels = [], shadeAbove, shadeBelow,
  showMAs = false, title, caption,
  markPeak = false, markTrough = false, peakNote, troughNote,
} = Astro.props;

const d = (series as any).tickers?.[ticker];
if (!d) throw new Error(`PriceChart: no series for ${ticker}`);

const n = d.close.length;
const W = 640, PAD_L = 42, PAD_R = 10;
const TOP_H = 170, IND_H = 90, GAP = 14, PAD_T = 10, PAD_B = 22;
const H = PAD_T + TOP_H + GAP + IND_H + PAD_B;
const plotW = W - PAD_L - PAD_R;

const xi = (i: number) => PAD_L + (i / (n - 1)) * plotW;

// price panel scale
const prices = d.close.filter((v: any) => v !== null) as number[];
const mas = showMAs ? [...d.ema50, ...d.ema200].filter((v: any) => v !== null) as number[] : [];
const pLo = Math.min(...prices, ...mas), pHi = Math.max(...prices, ...mas);
const pPad = (pHi - pLo) * 0.08 || 1;
const yP = (v: number) =>
  PAD_T + TOP_H - ((v - (pLo - pPad)) / ((pHi + pPad) - (pLo - pPad))) * TOP_H;

// indicator panel scale
const vals = d[indicator] as (number | null)[];
const clean = vals.filter((v) => v !== null) as number[];
const iLo = indicator === "rsi" ? 0 : Math.min(0, Math.min(...clean));
const iHi = indicator === "rsi" ? 100 : Math.max(...clean) * 1.08;
const IND_TOP = PAD_T + TOP_H + GAP;
const yI = (v: number) => IND_TOP + IND_H - ((v - iLo) / (iHi - iLo)) * IND_H;

const line = (arr: (number | null)[], y: (v: number) => number) => {
  let out = "", pen = false;
  arr.forEach((v, i) => {
    if (v === null) { pen = false; return; }
    out += `${pen ? "L" : "M"}${xi(i).toFixed(1)},${y(v).toFixed(1)}`;
    pen = true;
  });
  return out;
};

// extremes to annotate
const idxOf = (pick: (a: number, b: number) => number) => {
  let bi = -1, bv: number | null = null;
  vals.forEach((v, i) => {
    if (v === null) return;
    if (bv === null || pick(v, bv) === v) { bv = v; bi = i; }
  });
  return bi;
};
const peakI = markPeak ? idxOf(Math.max) : -1;
const troughI = markTrough ? idxOf(Math.min) : -1;

const label = { rsi: "RSI(14)", adx: "ADX(14)", vol_ratio: "Volume vs 20-day avg" }[indicator];
const fmtDate = (s: string) =>
  new Date(s).toLocaleDateString("en-IN", { day: "numeric", month: "short" });
---

<figure class="fig">
  <svg viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label={`${ticker} price with ${label} below, ${d.dates[0]} to ${d.dates[n - 1]}.`}>
    {/* ── indicator shading ─────────────────────────────────────────── */}
    {shadeAbove !== undefined && (
      <rect x={PAD_L} y={yI(iHi)} width={plotW} height={yI(shadeAbove) - yI(iHi)}
            fill="var(--down)" opacity="0.10" />
    )}
    {shadeBelow !== undefined && (
      <rect x={PAD_L} y={yI(shadeBelow)} width={plotW} height={yI(iLo) - yI(shadeBelow)}
            fill="var(--up)" opacity="0.10" />
    )}

    {/* ── price panel ───────────────────────────────────────────────── */}
    {showMAs && <path d={line(d.ema200, yP)} fill="none" stroke="var(--down)"
                      stroke-width="1.2" opacity="0.75" />}
    {showMAs && <path d={line(d.ema50, yP)} fill="none" stroke="var(--warn)"
                      stroke-width="1.2" opacity="0.85" />}
    <path d={line(d.close, yP)} fill="none" stroke="var(--ink)" stroke-width="1.7" />

    <text x={PAD_L} y={PAD_T + 10} font-size="11" font-weight="600"
          font-family="var(--sans)" fill="var(--ink)">{ticker}</text>
    {showMAs && (
      <text x={PAD_L + 62} y={PAD_T + 10} font-size="9" font-family="var(--mono)">
        <tspan fill="var(--warn)">— EMA50</tspan>
        <tspan fill="var(--down)">  — EMA200</tspan>
      </text>
    )}
    <text x={PAD_L - 6} y={yP(pHi) + 4} text-anchor="end" font-size="9"
          font-family="var(--mono)" fill="var(--faint)">{Math.round(pHi)}</text>
    <text x={PAD_L - 6} y={yP(pLo) + 4} text-anchor="end" font-size="9"
          font-family="var(--mono)" fill="var(--faint)">{Math.round(pLo)}</text>

    {/* ── indicator panel ───────────────────────────────────────────── */}
    {levels.map((lv) => (
      <g>
        <line x1={PAD_L} y1={yI(lv)} x2={W - PAD_R} y2={yI(lv)}
              stroke="var(--dim)" stroke-width="1" stroke-dasharray="3 3" opacity="0.6" />
        <text x={PAD_L - 6} y={yI(lv) + 3} text-anchor="end" font-size="9"
              font-family="var(--mono)" fill="var(--faint)">{lv}</text>
      </g>
    ))}
    <path d={line(vals, yI)} fill="none" stroke="var(--link)" stroke-width="1.6" />
    <text x={PAD_L} y={IND_TOP + 10} font-size="9" font-family="var(--mono)"
          fill="var(--dim)">{label}</text>

    {/* ── callouts joining both panels ──────────────────────────────── */}
    {[[peakI, peakNote, "var(--down)"], [troughI, troughNote, "var(--up)"]]
      .filter(([i]) => (i as number) >= 0)
      .map(([i, note, col]) => {
        const k = i as number;
        return (
          <g>
            <line x1={xi(k)} y1={PAD_T} x2={xi(k)} y2={IND_TOP + IND_H}
                  stroke={col as string} stroke-width="1" stroke-dasharray="2 3" opacity="0.8" />
            <circle cx={xi(k)} cy={yI(vals[k] as number)} r="3.4" fill={col as string} />
            <circle cx={xi(k)} cy={yP(d.close[k] as number)} r="3.4" fill={col as string} />
            <text x={Math.min(xi(k) + 6, W - 150)} y={PAD_T + 26}
                  font-size="9.5" font-family="var(--mono)" fill={col as string}>
              {note} · {(vals[k] as number).toFixed(1)} · {fmtDate(d.dates[k])}
            </text>
          </g>
        );
      })}

    {/* ── date axis ─────────────────────────────────────────────────── */}
    {[0, Math.floor(n / 2), n - 1].map((i) => (
      <text x={xi(i)} y={H - 7} text-anchor={i === 0 ? "start" : i === n - 1 ? "end" : "middle"}
            font-size="9" font-family="var(--mono)" fill="var(--faint)">{fmtDate(d.dates[i])}</text>
    ))}
  </svg>

  <figcaption>
    <strong>{title}</strong>{caption && <> — {caption}</>}
    <br />
    <span class="meta-line">
      {ticker} · real daily closes, {fmtDate(d.dates[0])} to {fmtDate(d.dates[n - 1])} ·
      not a drawing
    </span>
  </figcaption>
</figure>

<style>
  .fig { margin: 1.5rem 0 1.9rem; }
  .fig svg {
    width: 100%; height: auto; display: block;
    border: 1px solid var(--line); border-radius: 7px;
    background: var(--panel); padding: .3rem;
  }
  figcaption { font-size: .8rem; color: var(--dim); margin-top: .5rem; line-height: 1.5; }
  figcaption strong { color: var(--ink); }
  .meta-line { font-family: var(--mono); font-size: .72rem; color: var(--faint); }
</style>
